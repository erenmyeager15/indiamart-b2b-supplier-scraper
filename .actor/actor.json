{
    "actorSpecification": 1,
    "name": "indiamart-b2b-supplier-scraper",
    "title": "IndiaMART B2B Supplier Scraper - Product Leads",
    "description": "Scrape public IndiaMART category pages for B2B supplier/product leads with company names, product titles, cities, prices, URLs, images, and verification signals.",
    "version": "1.0",
    "categories": ["BUSINESS", "LEAD_GENERATION", "ECOMMERCE"],
    "dockerfile": "Dockerfile",
    "input": "../INPUT_SCHEMA.json",
    "storages": {
        "dataset": {
            "actorSpecification": 1,
            "views": {
                "suppliers": {
                    "title": "Supplier Leads",
                    "transformation": {
                        "fields": [
                            "sourceType",
                            "keyword",
                            "categoryName",
                            "productName",
                            "companyName",
                            "city",
                            "companyUrl",
                            "productUrl",
                            "contactActionAvailable",
                            "scrapedAt"
                        ]
                    },
                    "display": {
                        "component": "table",
                        "properties": {
                            "sourceType": { "label": "Source Type", "format": "text" },
                            "keyword": { "label": "Keyword", "format": "text" },
                            "categoryName": { "label": "Category", "format": "text" },
                            "productName": { "label": "Product", "format": "text" },
                            "companyName": { "label": "Company", "format": "text" },
                            "city": { "label": "City", "format": "text" },
                            "companyUrl": { "label": "Company URL", "format": "link" },
                            "productUrl": { "label": "Product URL", "format": "link" },
                            "contactActionAvailable": { "label": "Contact Action", "format": "boolean" },
                            "scrapedAt": { "label": "Scraped At", "format": "date" }
                        }
                    }
                }
            }
        }
    },
    "pricingInfo": {
        "pricingModel": "PAY_PER_EVENT",
        "pricingPerEvent": {
            "actorChargeEvents": {
                "supplier-scraped": {
                    "eventTitle": "Supplier scraped",
                    "eventDescription": "Charged once for each clean IndiaMART supplier lead record saved to the dataset.",
                    "eventPriceUsd": 0.003,
                    "isPrimaryEvent": true,
                    "isOneTimeEvent": false
                }
            }
        }
    },
    "defaultRunOptions": {
        "build": "latest",
        "memoryMbytes": 1024,
        "timeoutSecs": 3600
    },
    "minMemoryMbytes": 512,
    "maxMemoryMbytes": 4096,
    "webScraper": false
}
